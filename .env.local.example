# Supabase Credentials (Dapatkan dari Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
# PENTING: Gunakan Service Role Key agar server dapat melakukan upsert tanpa terhalang RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Rahasia API Key untuk validasi header 'x-api-key' dari Excel Office Scripts
API_SECRET_KEY=ganti_dengan_kunci_rahasia_acak_panjang_anda

